# Copie este arquivo para infra/.env antes de rodar `docker compose up`.

# --- PostgreSQL ---
POSTGRES_USER=saasgym
POSTGRES_PASSWORD=saasgym
POSTGRES_DB=saasgym
POSTGRES_PORT=5432

# --- Backend (NestJS) ---
# Dentro da rede do Docker Compose, o host do banco é o nome do serviço "postgres".
DATABASE_URL="postgresql://saasgym:saasgym@postgres:5432/saasgym?schema=public"
BACKEND_PORT=3000
# Mínimo 32 caracteres (validado no boot). Gere com: openssl rand -base64 32
JWT_ACCESS_SECRET="troque-este-segredo-de-acesso-em-producao-0000"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh-em-producao-0000"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
CORS_ORIGINS="http://localhost:5000,http://localhost:5001"

# --- Frontends (servidos via Nginx) ---
ADMIN_WEB_PORT=5000
STUDENT_WEB_PORT=5001
