NODE_ENV=development
PORT=3000

# Postgres (em docker-compose local, host = "postgres")
DATABASE_URL="postgresql://saasgym:saasgym@localhost:5432/saasgym?schema=public"

# JWT — mínimo 32 caracteres (validado no boot). Gere com: openssl rand -base64 32
JWT_ACCESS_SECRET="troque-este-segredo-de-acesso-em-producao-0000"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh-em-producao-0000"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# CORS - origens dos frontends (admin_web, student_web)
CORS_ORIGINS="http://localhost:5000,http://localhost:5001"

# Storage — "local" é a única implementação que existe hoje.
STORAGE_PROVIDER=local
UPLOADS_DIR=./uploads
TRIAL_DURATION_DAYS=14
