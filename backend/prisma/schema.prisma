// SaaSGym - Schema inicial (Sprint 0)
// Escopo desta migration: fundação de identidade e tenant.
// Demais entidades (Aluno, Professor, Plano, Agenda, Financeiro, Treinos...)
// são adicionadas incrementalmente nos sprints seguintes (ver docs/02-banco-de-dados.md).

generator client {
  provider      = "prisma-client-js"
  // "native" cobre o dev local (Windows/macOS/Linux glibc); a imagem de
  // produção roda em node:22-alpine (musl + OpenSSL 3), que precisa do
  // binary target explícito abaixo — sem isso o Prisma tenta detectar o
  // OpenSSL do container e falha silenciosamente para "openssl-1.1.x",
  // que não existe no Alpine 3.24+.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SYSTEM_ADMIN
  ACADEMIA_ADMIN
  RECEPCIONISTA
  PROFESSOR
  ALUNO
}

enum AcademiaStatus {
  TRIAL
  ATIVA
  INATIVA
}

enum UserStatus {
  ATIVO
  INATIVO
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGED
  REFRESH_TOKEN_USED
  REFRESH_TOKEN_REUSE_DETECTED
  SESSION_REVOKED
}

/// Tenant: cada academia cliente do SaaS.
model Academia {
  id        String         @id @default(uuid())
  nome      String
  cnpj      String?        @unique
  email     String?
  telefone  String?
  endereco  String?
  logoUrl   String?
  status    AcademiaStatus @default(TRIAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  users User[]

  @@map("academias")
}

/// Identidade de login. academiaId é nulo apenas para SYSTEM_ADMIN.
model User {
  id        String     @id @default(uuid())
  academiaId String?
  academia  Academia?  @relation(fields: [academiaId], references: [id], onDelete: Cascade)

  nome              String
  email             String     @unique
  senhaHash         String
  role              Role
  status            UserStatus @default(ATIVO)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@index([academiaId])
  @@map("users")
}

/// Tokens de refresh — cada um representa uma sessão (rotacionada via
/// "replacedBy" a cada /auth/refresh). A sessão ativa é o token no fim da
/// cadeia que ainda não foi revogado.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  ipAddress  String?
  userAgent  String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Trilha de auditoria de eventos de autenticação. "identifier" guarda o
/// e-mail tentado em falhas de login antes de se resolver a um usuário real
/// — por isso userId/academiaId são opcionais aqui.
model AuditLog {
  id         String      @id @default(uuid())
  academiaId String?
  userId     String?
  identifier String?
  action     AuditAction
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([academiaId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
